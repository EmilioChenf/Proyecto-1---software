PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=nexus_residencial
DB_CONNECTION_LIMIT=10
USE_BCRYPT=false
SESSION_SECRET=replace-with-a-long-random-secret
# Number of reverse-proxy hops in front of the backend (e.g. 1 on Railway/Render).
# Leave empty when the backend is reached directly. Needed so rate limits apply per client IP.
TRUST_PROXY=

# Backend only. HU13 needs the Sandbox key and ID; startup never calls Recurrente.
# The webhook secret remains unused until HU14. Never use a VITE_ prefix.
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
RECURRENTE_SANDBOX_ID=
