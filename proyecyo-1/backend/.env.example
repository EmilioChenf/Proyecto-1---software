PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=nexus_residencial
DB_CONNECTION_LIMIT=10
USE_BCRYPT=false
SESSION_SECRET=replace-with-a-long-random-secret
# Number of reverse-proxy hops in front of the backend (e.g. 1 on Railway/Render).
# Leave empty when the backend is reached directly. Needed so rate limits apply per client IP.
TRUST_PROXY=

# Backend only. HU13 needs the Sandbox key and ID; startup never calls Recurrente.
# The webhook secret remains unused until HU14. Never use a VITE_ prefix.
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
RECURRENTE_SANDBOX_ID=

# Correo (Gmail). SMTP_USER = cuenta de Gmail del sistema; SMTP_PASS = clave de
# aplicacion de 16 letras (myaccount.google.com/apppasswords). Nunca subir la clave real.
# Railway solo permite SMTP en el plan Pro.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=NexusResidencial
# Copia por correo de todas las notificaciones de la app (true por defecto).
EMAIL_NOTIFICATIONS_ENABLED=true

# Copia por cliente (ver docs/despliegue/NUEVO-RESIDENCIAL.md)
# false = abre directo el inicio de sesion, sin la pagina comercial.
PUBLIC_LANDING=true
# Primer arranque con base vacia: crea esquema, administrador y nombre del residencial.
BOOTSTRAP_RESIDENCIAL_NOMBRE=
BOOTSTRAP_ADMIN_NOMBRE=
BOOTSTRAP_ADMIN_CORREO=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CONTACTO_TELEFONO=
BOOTSTRAP_DIRECCION=
# si = reemplaza los datos de ejemplo de una base que solo tiene datos demo.
BOOTSTRAP_LIMPIAR_DEMO=
